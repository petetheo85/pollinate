# API key for the configured provider (currently Google Gemini)
LLM_API_KEY=your_llm_api_key_here
MODEL_NAME=your_model_name_here

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match the token entered in the extension options.
CAPTURE_TOKEN=generate_a_token_and_paste_it_here
